# Hugging Face token — required for pyannote speaker diarization model
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_API_TOKEN=""

# Mistral AI API key — required for meeting minutes generation
# Get yours at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=""

# Whisper model size: tiny, base, small, medium, large
# Larger = more accurate but slower
WHISPER_MODEL_SIZE=
